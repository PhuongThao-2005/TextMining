LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=replace-with-your-key
LLM_BASE_MODEL=gpt-4o-mini
LLM_LARGER_MODEL=gpt-4o

# Optional. Leave this as-is if the graph pickle is stored at data/graph/knowledge_graph.gpickle.
GRAPH_PICKLE_PATH=data/graph/knowledge_graph.gpickle

# Default local mode avoids Hugging Face network retries. Set to 0 for the first reranker model download.
HF_HUB_OFFLINE=1

# Keep model/cache downloads on this project drive instead of C:\Users\...
XDG_CACHE_HOME=.cache
HF_HOME=.cache/huggingface
TRANSFORMERS_CACHE=.cache/huggingface/hub
SENTENCE_TRANSFORMERS_HOME=.cache/sentence-transformers
TORCH_HOME=.cache/torch

# Optional. Leave blank to clear a broken inherited proxy while downloading
# Hugging Face models; set a real proxy URL if your network requires one.
HTTP_PROXY=
HTTPS_PROXY=
